# CreditPulse environment configuration (local DuckDB mode).
# Copy to .env and adjust paths. .env is gitignored — never commit real secrets.
# In local mode there are no real credentials.

# --- Paths ---
# Root for raw/processed data files (gitignored).
DATA_DIR=./data

# DuckDB warehouse file.
DUCKDB_PATH=./warehouse/creditpulse.duckdb

# dbt profiles location (defaults to ./dbt when running dbt from there).
DBT_PROFILES_DIR=./dbt

# --- Production target (NOT used in local mode; documented in ARCHITECTURE.md) ---
# Uncomment and fill only if connecting to Snowflake.
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_ROLE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_PRIVATE_KEY_PATH=
